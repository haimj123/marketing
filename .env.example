# Optional. When unset the app reads from the committed seed file in
# src/data/seed-organizations.json, so `npm run dev` works with no services.
DATABASE_URL=

# Public site URL, used for canonical links, sitemap and OG images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (M2+ — auth, storage). Not required to run the directory.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (claim codes, digests)
RESEND_API_KEY=
